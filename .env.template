# --- Settings ---
DEBUG=true  # prod: false
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]  # prod: ["https://example.com"]

# --- Application ----
APP__TITLE="FastAPI Starter"
APP__DOCS_URL="/docs"             # prod: empty
APP__REDOC_URL="/redoc"           # prod: empty
APP__OPENAPI_URL="/openapi.json"  # prod: empty

# --- Run ----
RUN__HOST="127.0.0.1"  # docker: 0.0.0.0
RUN__PORT=8000
RUN__WORKERS=2
RUN__RELOAD=false

# --- Database ----
# Local runs read DB__* directly. Under docker-compose the connection block is
# overridden from the POSTGRES__* values below, which also seed the container.
DB__HOST=localhost  # docker: db
DB__PORT=5432
DB__HOST_PORT=5432  # localhost run port
DB__USER=postgres
DB__PASSWORD=postgres
DB__NAME=db_name

DB__ECHO=false       # logs every SQL statement, debugging only
DB__ECHO_POOL=false  # logs pool checkout/checkin, debugging only

# Per worker process: workers * (POOL_SIZE + MAX_OVERFLOW) must stay under the
# server's max_connections (100 by default).
DB__POOL_SIZE=10
DB__MAX_OVERFLOW=5
DB__POOL_TIMEOUT=30       # seconds to wait for a free connection
DB__POOL_RECYCLE=1800     # seconds; keep below any server/proxy idle timeout
DB__POOL_PRE_PING=true    # one round-trip per checkout, drops dead connections
DB__STATEMENT_TIMEOUT_MS=10000

# --- Cache ---
REDIS__HOST=localhost      # docker: redis
REDIS__PORT=6379
REDIS__PASSWORD=123456789
REDIS__DB=0

REDIS__MAX_CONNECTIONS=20
REDIS__SOCKET_TIMEOUT_SECONDS=5            # seconds a command may hang before raising
REDIS__SOCKET_CONNECT_TIMEOUT_SECONDS=5    # seconds to establish the socket
REDIS__HEALTH_CHECK_INTERVAL_SECONDS=30    # seconds between PINGs on idle connections; 0 disables
